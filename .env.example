# =================================================================
# Observability Copilot - Master Environment Configuration Template
# =================================================================

# 1. OpenAI API Configuration (Required for GPT-4o Root Cause Analysis)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# 2. SigNoz Cloud / OpenTelemetry Collector Settings
OTEL_SERVICE_NAME=observability-copilot-backend
OTEL_RESOURCE_ATTRIBUTES=service.name=observability-copilot-backend,service.version=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=your_signoz_ingestion_key_here
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=none

# 3. SigNoz MCP Server Credentials
SIGNOZ_MCP_URL=https://mcp.us2.signoz.cloud/mcp
SIGNOZ_INSTANCE_URL=https://meet-stag.us2.signoz.cloud
SIGNOZ_API_KEY=your_signoz_service_account_key_here

# 4. Slack Bot Auto-Remediation Webhook (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# 5. Frontend & Backend URLs
PORT=8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_COPILOT_BACKEND=https://observability-copilot-backend.onrender.com
